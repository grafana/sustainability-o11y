{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  // Major update configuration
  major: {
    labels: [
      'update-major',
    ],
  },
  // Minor update configuration
  minor: {
    labels: [
      'update-minor',
    ],
  },
  // Patch update configuration
  patch: {
    labels: [
      'update-patch',
    ],
  },
  // Package rules
  packageRules: [
    {
      // Auto-merge patch updates with squash
      matchUpdateTypes: ['patch'],
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
    },
  ],
}
